# Kopieren nach ~/.config/weiss/weiss.env (macht scripts/install.sh).
# Format: KEY=value, ohne Anführungszeichen (systemd/podman --env-file).

DEMO_MODE=true
APP_HOSTNAME=localhost
ENABLE_HTTPS=false

# EPICS - lokale Channel-Access-Werte
EPICS_DEFAULT_PROTOCOL=ca
EPICS_CA_ADDR_LIST=localhost
EPICS_CA_AUTO_ADDR_LIST=YES
EPICS_CA_MAX_ARRAY_BYTES=1000000
EPICS_PVA_ADDR_LIST=localhost
EPICS_PVA_AUTO_ADDR_LIST=YES
EPICS_MAX_UPDATE_RATE_HZ=30
EPICS_MAX_CLIENT_QUEUE=1000

# API / Git-Identität für Commits
TECHNICAL_ACCOUNT_TOKEN=
TECHNICAL_ACCOUNT_USERNAME=weiss-bot
TECHNICAL_ACCOUNT_EMAIL=weiss-bot@example.com

# OAuth2 (nur wenn DEMO_MODE=false)
AUTH_IDENTITY_PROVIDER=oauth
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_ISSUER=

# Git-Import im API-Container: Standard-Timeout 180s statt 30s
WEISS_GIT_TIMEOUT_SECONDS=180

# Proxy fuer Container-Runtime (falls noetig)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,weiss,weiss-api,weiss-epicsws,host.containers.internal

# Optional zusaetzlich in Kleinbuchstaben fuer Tools, die nur diese lesen
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1,weiss,weiss-api,weiss-epicsws,host.containers.internal
