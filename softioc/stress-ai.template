# Analogkanal des Stresstests (geladen über stress.substitutions)
# Makros: P = PV-Präfix, S = Sektor, N = Kanal, PHASE = Phasenversatz in rad
# Sinus um 50 mit Periode 40 Takte, Amplitude AMPL, Rauschen NOISE.
# MDEL -1: sendet bei jedem Takt ein Update, auch ohne Wertänderung.
record(calc, "$(P)S$(S):A$(N)") {
    field(DESC, "Sektor $(S) Analog $(N)")
    field(SCAN, "Event")
    field(EVNT, "stress")
    field(INPA, "$(P)TICKS NPP")
    field(INPB, "$(P)AMPL NPP")
    field(INPC, "$(PHASE)")
    field(INPD, "$(P)NOISE NPP")
    field(CALC, "50+B*SIN(A*0.15708+C)+D*(RNDM*2-1)")
    field(MDEL, "-1")
    field(PREC, "1")
    field(LOPR, "0")
    field(HOPR, "100")
    field(HIHI, "95")
    field(HIGH, "85")
    field(LOW,  "15")
    field(LOLO, "5")
    field(HHSV, "MAJOR")
    field(HSV,  "MINOR")
    field(LSV,  "MINOR")
    field(LLSV, "MAJOR")
}
